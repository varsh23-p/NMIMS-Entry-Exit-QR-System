<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!-- TOP HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/top_curve"
            android:orientation="vertical">

            <ImageView
                android:layout_width="130dp"
                android:layout_height="52dp"
                android:layout_marginTop="45dp"
                android:layout_marginStart="50dp"
                android:scaleType="fitXY"
                android:src="@drawable/nmims" />

        </LinearLayout>

        <!-- APP TITLE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="NMIMS"
                android:textColor="#A0001E"
                android:textSize="34sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:src="@drawable/text" />

        </LinearLayout>

        <!-- REGISTRATION CARD -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="18dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="25dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- TITLE -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="🎓 Student Registration"
                    android:textColor="#A0001E"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- PHOTO -->

                <ImageView
                    android:id="@+id/imgStudentPhoto"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:background="@android:drawable/picture_frame"
                    android:clickable="true"
                    android:contentDescription="Student Photo"
                    android:focusable="true"
                    android:padding="5dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/stud" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:text="Tap to Upload Photo"
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <!-- STUDENT ID -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Student SAP ID"
                    android:textColor="#333333"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etStudentId"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="Enter SAP ID"
                    android:inputType="number"
                    android:padding="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888" />

                <!-- NAME -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Student Name"
                    android:textColor="#333333"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="Enter Student Name"
                    android:padding="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888" />

                <!-- PHONE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Phone Number"
                    android:textColor="#333333"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="Enter Phone Number"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:padding="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888" />

                <!-- BRANCH -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Branch"
                    android:textColor="#333333"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etBranch"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="Enter Branch"
                    android:padding="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888" />

                <!-- YEAR -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Year"
                    android:textColor="#333333"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerYear"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:background="@android:drawable/editbox_background" />

                <!-- RESIDENCE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Residence Type"
                    android:textColor="#333333"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioGroupResidence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbHosteller"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hosteller"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbDayScholar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="Day Scholar"
                        android:textStyle="bold" />

                </RadioGroup>

                <!-- DC -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="DC Information"
                    android:textColor="#333333"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioGroupDC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbDC"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DC"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbNonDC"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="Non-DC"
                        android:textStyle="bold" />

                </RadioGroup>

                <!-- DC COUNT -->

                <EditText
                    android:id="@+id/etDCCount"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="10dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="Enter Number of DC"
                    android:inputType="number"
                    android:padding="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:visibility="gone" />

                <!-- REGISTER BUTTON -->

                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="28dp"
                    android:backgroundTint="#A0001E"
                    android:text="REGISTER STUDENT"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>